# Vercel 환경변수에 등록할 키 목록
# VITE_ 접두어를 붙이면 번들에 그대로 노출되므로 절대 사용 금지.
# 아래 키는 서버(api/ 함수)에서만 읽힘.

CAREERNET_API_KEY=your_careernet_api_key_here

# ── 커뮤니티 백엔드(Supabase) ────────────────────────────────────────────
# 아래 두 키가 모두 있으면 Supabase 백엔드, 비어 있으면 자동으로
# localStorage 목(mock) 백엔드로 폴백한다(키 없이 즉시 데모 가능).
# anon 키는 클라이언트(VITE_)에 노출돼도 안전하다 — supabase/schema.sql 의
# RLS가 모든 쓰기를 'auth.uid() = 본인'으로 막는다. 세팅법은 schema.sql 상단 참고.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
